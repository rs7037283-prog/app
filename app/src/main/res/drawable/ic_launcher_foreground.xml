<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer accent glowing ring -->
    <path
        android:strokeWidth="1.5"
        android:strokeColor="#8B5CF6"
        android:fillColor="#00000000"
        android:pathData="M 54,24 A 30,30 0 1,1 53.99,24 Z" />

    <!-- Sleek inner play triangle representing movie reels/videos -->
    <path
        android:pathData="M 46,38 L 68,54 L 46,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="38"
                android:endX="68"
                android:endY="70">
                <item android:color="#8B5CF6" android:offset="0.0" />
                <item android:color="#D946EF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star sparkles embellishing AI magic on top-right -->
    <path
        android:fillColor="#FAFAFA"
        android:pathData="M 72,26 L 74,31 L 79,33 L 74,35 L 72,40 L 70,35 L 65,33 L 70,31 Z" />
</vector>
