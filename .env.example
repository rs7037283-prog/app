# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional: Firebase credentials for live Cloud Auth & Firestore sync
# If blank, the application uses local Room database and persistent session mode
FIREBASE_API_KEY=MY_FIREBASE_API_KEY
FIREBASE_PROJECT_ID=MY_FIREBASE_PROJECT_ID
FIREBASE_APPLICATION_ID=MY_FIREBASE_APPLICATION_ID
